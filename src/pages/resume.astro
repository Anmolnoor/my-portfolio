---
import Main from "@/layouts/Main.astro";
import { getCollection } from "astro:content";
import { stack, now } from "@/components/about/aboutData";
import { projects, type Project } from "@/assets/projects";
import { formatDateUTC, getPostSlug } from "@/lib/blog";

const summary =
  "Software engineer focused on local-first coding agents, developer tools, and full-stack products. My work explores how coding agents can operate with clear boundaries, independent verification, and human approval. I also build real-time applications and run a self-hosted homelab.";

const resumeTitles = [
  "skep",
  "Foundation CLI",
  "Beekeeper",
  "agent-policy-gate",
  "scripts",
  "claude-dotfiles",
  "Amend Notes",
  "Vendro",
];
const resumeProjects = resumeTitles
  .map((t) => projects.find((p) => p.title === t))
  .filter((p): p is Project => Boolean(p));

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

// Substantive roles only; short trainings omitted.
const experience = [
  {
    role: "Founder",
    company: "Dynamic Nexus Solutions",
    link: "https://www.dynamicnexussolutions.com/",
    duration: "Present",
  },
  {
    role: "Frontend Engineer",
    company: "Huddle01",
    link: "https://huddle01.com/",
    duration: "5 months (2 full-time, 3 part-time)",
  },
];

const contacts = [
  { label: "Vancouver, BC" },
  { label: "anmolnoor59@gmail.com", href: "mailto:anmolnoor59@gmail.com" },
  { label: "anmolnoor.com", href: "https://anmolnoor.com" },
  { label: "github.com/Anmolnoor", href: "https://github.com/Anmolnoor" },
  {
    label: "linkedin.com/in/anmol-noor",
    href: "https://www.linkedin.com/in/anmol-noor/",
  },
];
---

<Main title="Resume — Anmol Noor">
  <article
    class="resume mx-auto w-[210mm] max-w-full rounded-xl border border-border bg-card p-6 sm:p-8 md:p-10 print:w-full print:max-w-none print:rounded-none print:border-0 print:bg-white print:p-0 print:text-black print:shadow-none"
  >
    <!-- header -->
    <header class="pb-2">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="font-mono text-4xl font-bold tracking-tight">Anmol Noor</h1>
          <p class="mt-1 font-mono text-sm uppercase tracking-widest text-primary">
            Software Engineer
          </p>
        </div>
        <button
          type="button"
          onclick="window.print()"
          class="rounded-md border border-border px-3 py-1.5 font-mono text-xs text-muted-foreground transition-colors hover:border-primary hover:text-primary print:hidden"
        >
          Print / Save PDF
        </button>
      </div>
      <p class="mt-3 flex flex-wrap gap-x-2 gap-y-1 font-mono text-xs text-muted-foreground">
        {
          contacts.map((c, i) => (
            <span>
              {i > 0 && <span aria-hidden="true">· </span>}
              {c.href ? (
                <a href={c.href} class="transition-colors hover:text-primary">
                  {c.label}
                </a>
              ) : (
                c.label
              )}
            </span>
          ))
        }
      </p>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
        {summary}
      </p>
    </header>

    <div class="flex flex-col gap-9 pt-8">
      <!-- focus -->
      <section>
        <h2
          class="mb-4 border-b border-border pb-2 font-mono text-xs font-bold uppercase tracking-widest text-primary"
        >
          Focus
        </h2>
        <ul class="space-y-2">
          {
            now.map((item) => (
              <li class="text-sm">
                <span class="font-semibold text-foreground">{item.title}</span>
                <span class="text-muted-foreground"> — {item.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- experience -->
      <section>
        <h2
          class="mb-4 border-b border-border pb-2 font-mono text-xs font-bold uppercase tracking-widest text-primary"
        >
          Experience
        </h2>
        <div class="space-y-3">
          {
            experience.map((e) => (
              <div class="flex break-inside-avoid flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="font-mono text-sm font-bold">
                  {e.role}
                  <span class="font-normal text-primary">
                    {" "}
                    · <a href={e.link} target="_blank" rel="noreferrer" class="hover:underline">{e.company}</a>
                  </span>
                </h3>
                <span class="font-mono text-xs text-muted-foreground">
                  {e.duration}
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- skills -->
      <section>
        <h2
          class="mb-4 border-b border-border pb-2 font-mono text-xs font-bold uppercase tracking-widest text-primary"
        >
          Technical Skills
        </h2>
        <div class="space-y-3">
          {
            stack.map((group) => (
              <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                <p class="w-36 shrink-0 font-mono text-xs uppercase tracking-wider text-muted-foreground sm:pt-0.5">
                  {group.group}
                </p>
                <div class="flex flex-wrap gap-x-2 gap-y-1.5">
                  {group.items.map((i) => (
                    <span class="rounded border border-lime-500/25 bg-lime-500/5 px-2 py-0.5 font-mono text-xs text-foreground">
                      {i.name}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- projects -->
      <section>
        <h2
          class="mb-4 border-b border-border pb-2 font-mono text-xs font-bold uppercase tracking-widest text-primary"
        >
          Selected Projects
        </h2>
        <div class="space-y-5">
          {
            resumeProjects.map((p) => {
              const external = p.link.startsWith("http");
              return (
                <div class="break-inside-avoid">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                    <h3 class="font-mono text-sm font-bold">
                      {p.title}
                      {p.tagline && (
                        <span class="font-normal text-primary">
                          {" "}
                          · {p.tagline}
                        </span>
                      )}
                    </h3>
                    <a
                      href={p.link}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noreferrer" : undefined}
                      class="font-mono text-xs text-muted-foreground transition-colors hover:text-primary"
                    >
                      {external ? "View ↗" : "View →"}
                    </a>
                  </div>
                  <p class="mt-1 text-sm text-muted-foreground">
                    {p.description}
                  </p>
                  {p.techTags && p.techTags.length > 0 && (
                    <p class="mt-1.5 font-mono text-xs text-muted-foreground">
                      {p.techTags.join(" · ")}
                    </p>
                  )}
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- writing -->
      <section>
        <h2
          class="mb-4 border-b border-border pb-2 font-mono text-xs font-bold uppercase tracking-widest text-primary"
        >
          Writing
        </h2>
        <div class="space-y-2.5">
          {
            posts.map((post) => (
              <div class="flex break-inside-avoid items-baseline justify-between gap-x-4">
                <a
                  href={`/blog/${getPostSlug(post)}`}
                  title={post.data.title}
                  class="min-w-0 truncate text-sm text-foreground transition-colors hover:text-primary"
                >
                  {post.data.title}
                </a>
                <span class="shrink-0 font-mono text-xs text-muted-foreground">
                  {formatDateUTC(post.data.date, { month: "short", year: "numeric" })}
                </span>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </article>
</Main>

<style>
  @media print {
    /* Print the resume alone: hide site nav/footer and use light-theme colors
       even when the page is in dark mode. */
    :global(body) {
      background: white;
    }
    :global(body > div > :not(main)) {
      display: none;
    }
    :global(main) {
      max-width: none;
      padding: 0;
    }
    .resume {
      --foreground: 20 10% 10%;
      --card-foreground: 20 10% 10%;
      --muted-foreground: 30 5% 40%;
      --primary: 82 75% 27%;
      --border: 60 8% 88%;
    }
  }
</style>
